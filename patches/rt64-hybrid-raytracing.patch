+
+    void FramebufferRenderer::submitHybridRaytracing(RenderWorker *worker, const Framebuffer &framebuffer, bool &depthState) {
+        RenderFramebufferStorage *fbStorage = framebuffer.renderTargetDrawCall.fbStorage;
+        RenderTarget *colorTarget = fbStorage->colorTarget;
+        RenderTarget *depthTarget = fbStorage->depthTarget;
+        if ((colorTarget == nullptr) || (depthTarget == nullptr)) {
+            return;
+        }
+
+        HybridRaytracingTarget target;
+        target.colorTexture = colorTarget->texture.get();
+        target.depthTexture = depthTarget->texture.get();
+        target.depthTextureView = depthTarget->textureView.get();
+        target.framebuffer = fbStorage->colorWriteDepthRead.get();
+        target.colorFormat = colorTarget->format;
+        target.depthFormat = depthTarget->format;
+        target.multisampling = colorTarget->multisampling;
+        target.width = std::min({ uint32_t(std::lround(framebuffer.viewport.width)), colorTarget->width, depthTarget->width });
+        target.height = std::min({ uint32_t(std::lround(framebuffer.viewport.height)), colorTarget->height, depthTarget->height });
+        hybridRaytracer->recordPass(worker->commandList.get(), target);
+
+        // The pass leaves the color write and depth read framebuffer bound.
+        depthState = true;
+    }
+
+    bool FramebufferRenderer::isHybridRaytracingCaster(const GameCall &call, const HybridRaytracingConfiguration &config) {
+        const interop::OtherMode &otherMode = call.callDesc.otherMode;
+        const uint32_t cycleType = otherMode.cycleType();
+        if ((cycleType == G_CYC_FILL) || (cycleType == G_CYC_COPY)) {
+            return false;
         }
+
+        if (call.callDesc.extendedType != DrawExtendedType::None) {
+            return false;
+        }
+
+        // Only solid geometry that writes depth can cast shadows. Decals are coplanar with the surfaces they're on.
+        if (!otherMode.zUpd() || (otherMode.zMode() == ZMODE_DEC)) {
+            return false;
+        }
+
+        // Cutouts have no texture information in the acceleration structure and would cast fully opaque shadows.
+        const bool alphaTested = (otherMode.alphaCompare() != G_AC_NONE) || otherMode.cvgXAlpha();
+        if (alphaTested && !config.alphaTestedCasters) {
+            return false;
+        }
+
+        return call.callDesc.triangleCount > 0;
+    }
+
+    HybridRaytracingSelection FramebufferRenderer::selectHybridRaytracingScene(const Workload &workload, uint32_t fbPairCount, const HybridRaytracingConfiguration &config) {
+        // Pick the perspective projection with the most shadow casting triangles. The framebuffer pair it belongs
+        // to is considered the main 3D scene of the frame.
+        HybridRaytracingSelection selection;
+        uint32_t bestTriangleCount = 0;
+        for (uint32_t f = 0; f < fbPairCount; f++) {
+            const FramebufferPair &fbPair = workload.fbPairs[f];
+            if (!fbPair.depthWrite) {
+                continue;
+            }
+
+            for (uint32_t p = 0; p < fbPair.projectionCount; p++) {
+                const Projection &proj = fbPair.projections[p];
+                if ((proj.type != Projection::Type::Perspective) || proj.scissorRect.isNull()) {
+                    continue;
+                }
