@@ -0,0 +1,272 @@
+//
+// RT64
+//
+// Hybrid ray tracing: ray traced sun shadows and ambient occlusion layered on top of the rasterized N64 image.
+//
+// The renderer keeps rasterizing the game exactly as before. After the 3D scene of the main framebuffer has been
+// drawn (and before the HUD), the depth buffer is used to reconstruct the world position of every pixel, rays are
+// traced against an acceleration structure built from the world space geometry of the frame and the filtered
+// visibility is multiplied on top of the image.
+//
+// This class only depends on plume so it can be driven by the framebuffer renderer as well as standalone tests.
+//
+
+#pragma once
+
+#include <filesystem>
+#include <memory>
+#include <vector>
+
+#include <json/json.hpp>
+
+#include "common/rt64_plume.h"
+#include "shared/rt64_hybrid_raytracing_params.h"
+#include "shared/rt64_rsp_viewport.h"
+
+namespace RT64 {
+    struct HybridRaytracingConfiguration {
+        enum class DebugView {
+            None,
+            Shadows,
+            AmbientOcclusion,
+            Combined,
+            Normals,
+            OptionCount
+        };
+
+        bool enabled = true;
+        bool shadows = true;
+        bool ambientOcclusion = true;
+
+        // Sun direction in the game's world space (Y is up). Azimuth rotates around the Y axis. The game has no
+        // single light direction, so the default is a high sun that keeps most of Spiral Mountain lit.
+        float sunAzimuthDegrees = 215.0f;
+        float sunElevationDegrees = 60.0f;
+
+        // Angular radius of the sun disk. Larger values produce softer shadows.
+        float sunAngularRadiusDegrees = 1.0f;
+
+        // How much the sun visibility darkens the image (0 = none, 1 = fully black shadows).
+        float shadowStrength = 0.6f;
+
+        // How much surfaces facing away from the sun are darkened. Most of the game's geometry has baked vertex
+        // lighting already, so this is kept moderate by default.
+        float nDotLStrength = 0.35f;
+
+        // Maximum distance a shadow ray can travel in game units.
+        float shadowMaxDistance = 20000.0f;
+
+        // Ambient occlusion.
+        int aoSamples = 2;
+        float aoRadius = 120.0f;
+        float aoStrength = 0.6f;
+
+        // Offset applied to ray origins along the reconstructed normal, in game units.
+        float normalBias = 2.0f;
+
+        // Depth buffer values at or above this threshold are considered to be the cleared background (sky).
+        float skyDepth = 0.99999f;
+
+        // Joint bilateral filter. A radius of 0 disables the filter. The depth sigma is the tolerated distance to the
+        // surface's plane relative to the distance to the camera.
+        int denoiseRadius = 6;
+        float denoiseDepthSigma = 0.02f;
+        float denoiseNormalPower = 8.0f;
+
+        // Fade out sun shadows when the sun is blocked almost everywhere on screen (e.g. inside a house). The fade happens
+        // between these two values of the average sun visibility of the visible geometry.
+        bool interiorDetection = true;
+        float interiorFadeStart = 0.08f;
+        float interiorFadeEnd = 0.25f;
+
+        // Include draw calls that use alpha compare (cutouts like fences and foliage) as shadow casters. They're
+        // treated as fully opaque since the acceleration structure has no texture information.
+        bool alphaTestedCasters = false;
+
+        // Vary the noise pattern each frame. Stable noise is used by default as there's no temporal accumulation.
+        bool temporalNoise = false;
+
+        DebugView debugView = DebugView::None;
+
+        hlslpp::float3 sunDirection() const;
+        void validate();
+        bool active() const;
+
+        // Path used when loading and saving the configuration. The RT64_HYBRID_RT_CONFIG environment
+        // variable overrides it. Otherwise "rt64_hybrid_rt.json" in the working directory is used.
+        static std::filesystem::path defaultPath();
+        bool load(const std::filesystem::path &path);
+        bool save(const std::filesystem::path &path) const;
+    };
+
+    void to_json(nlohmann::json &j, const HybridRaytracingConfiguration &cfg);
+    void from_json(const nlohmann::json &j, HybridRaytracingConfiguration &cfg);
+
+    // Describes the camera and the chain of viewport transformations used by the rasterizer for the scene.
+    struct HybridRaytracingCamera {
+        // World to clip space transform as used by the RSP (row vector convention, same as RT64's transforms).
+        hlslpp::float4x4 viewProj;
+
+        // N64 viewport transform (in native framebuffer pixels).
+        interop::RSPViewport viewport;
+
+        // Native framebuffer resolution used by the raster vertex shader to convert screen coordinates to NDC.
+        hlslpp::float2 fbResolution;
+
+        // Screen scale and offset applied by the raster vertex shader after the conversion to NDC.
+        hlslpp::float2 screenScale;
+        hlslpp::float2 screenOffset;
+
+        // Size of the render viewport in target pixels.
+        float targetWidth = 0.0f;
+        float targetHeight = 0.0f;
+    };
+
+    // Computes the matrix that converts (pixelX, pixelY, depth, 1) in the target into homogeneous world space.
+    hlslpp::float4x4 computeHybridPixelToWorld(const HybridRaytracingCamera &camera);
+
+    struct HybridRaytracingGeometry {
+        // Vertex inputs of the workload, as used by RSPWorldCS.
+        const RenderBuffer *positionBuffer = nullptr;
+        const RenderBufferFormattedView *positionView = nullptr;
+        const RenderBuffer *velocityBuffer = nullptr;
+        const RenderBufferFormattedView *velocityView = nullptr;
+        const RenderBuffer *worldIndicesBuffer = nullptr;
+        const RenderBufferFormattedView *worldIndicesView = nullptr;
+        const RenderBuffer *worldTransformsBuffer = nullptr;
+        uint32_t vertexCount = 0;
+        float curFrameWeight = 1.0f;
+
+        // Triangle list of the shadow casters using global vertex indices.
+        const uint32_t *indices = nullptr;
+        uint32_t indexCount = 0;
+    };
+
+    struct HybridRaytracingTarget {
+        RenderTexture *colorTexture = nullptr;
+        RenderTexture *depthTexture = nullptr;
+        const RenderTextureView *depthTextureView = nullptr;
+
+        // Framebuffer with the color target writable and the depth target read-only.
+        const RenderFramebuffer *framebuffer = nullptr;
+        RenderFormat colorFormat = RenderFormat::UNKNOWN;
+        RenderFormat depthFormat = RenderFormat::UNKNOWN;
+        RenderMultisampling multisampling;
+
+        // Size of the region to process, starting at the origin of the target.
+        uint32_t width = 0;
+        uint32_t height = 0;
+    };
+
+    struct HybridRaytracer {
+        HybridRaytracer(RenderDevice *device, RenderShaderFormat shaderFormat);
+        ~HybridRaytracer();
+
+        // Whether the device supports the ray tracing pipeline required by this pass.
+        bool isSupported() const;
+
+        void setConfiguration(const HybridRaytracingConfiguration &config);
+        const HybridRaytracingConfiguration &getConfiguration() const;
+
+        // Uploads the geometry and parameters for this frame. Must be called before recording the command list.
+        // Returns whether there's anything to trace this frame.
+        bool prepare(const HybridRaytracingGeometry &geometry, const HybridRaytracingCamera &camera, uint32_t frameIndex);
+        bool isPrepared() const;
+        void reset();
+
+        // Discards the values accumulated over previous frames (e.g. the smoothed sun visibility used for interior detection).
+        void resetTemporalState();
+
+        // Computes the world space vertices and builds the acceleration structures.
+        void recordSetup(RenderCommandList *commandList);
+
+        // Traces, filters and composites the result into the target. When this function returns, the target's framebuffer
+        // is bound, the color texture is in COLOR_WRITE and the depth texture is in DEPTH_READ.
+        void recordPass(RenderCommandList *commandList, const HybridRaytracingTarget &target);
+
+    private:
+        struct CompositePipelines {
+            RenderFormat colorFormat = RenderFormat::UNKNOWN;
+            RenderFormat depthFormat = RenderFormat::UNKNOWN;
+            uint32_t sampleCount = 0;
+            std::unique_ptr<RenderPipeline> multiply;
+            std::unique_ptr<RenderPipeline> replace;
+        };
+
+        RenderDevice *device = nullptr;
+        RenderShaderFormat shaderFormat = RenderShaderFormat::UNKNOWN;
+        bool supported = false;
+        bool prepared = false;
+        HybridRaytracingConfiguration config;
+        interop::HybridRaytracingParams params;
+        interop::HybridRaytracingWorldCB worldCB;
+
+        // Pipelines.
+        std::unique_ptr<RenderPipelineLayout> worldLayout;
+        std::unique_ptr<RenderPipeline> worldPipeline;
+        std::unique_ptr<RenderPipelineLayout> depthCopyLayout;
+        std::unique_ptr<RenderPipeline> depthCopyPipeline;
+        std::unique_ptr<RenderPipeline> depthCopyMSPipeline;
+        std::unique_ptr<RenderPipelineLayout> traceLayout;
+        std::unique_ptr<RenderPipelineLayout> traceGlobalLayout;
+        std::unique_ptr<RenderPipeline> tracePipeline;
+        std::unique_ptr<RenderPipelineLayout> denoiseLayout;
+        std::unique_ptr<RenderPipeline> denoisePipeline;
+        std::unique_ptr<RenderPipelineLayout> statsLayout;
+        std::unique_ptr<RenderPipeline> statsPipeline;
+        std::unique_ptr<RenderPipelineLayout> compositeLayout;
+        std::unique_ptr<RenderShader> fullScreenVertexShader;
+        std::unique_ptr<RenderShader> compositePixelShader;
+        std::vector<CompositePipelines> compositePipelines;
+
+        // Descriptor sets.
+        std::unique_ptr<RenderDescriptorSetBase> worldSet;
+        std::unique_ptr<RenderDescriptorSetBase> depthCopySet;
+        std::unique_ptr<RenderDescriptorSetBase> traceSet;
+        std::unique_ptr<RenderDescriptorSetBase> denoiseSets[2];
+        std::unique_ptr<RenderDescriptorSetBase> statsSet;
+        std::unique_ptr<RenderDescriptorSetBase> compositeSet;
+
+        // Shader binding table.
+        RenderShaderBindingTableInfo shaderBindingTableInfo;
+        std::unique_ptr<RenderBuffer> shaderBindingTableBuffer;
+
+        // Geometry and acceleration structures.
+        std::unique_ptr<RenderBuffer> worldPositionBuffer;
+        uint64_t worldPositionBufferSize = 0;
+        std::unique_ptr<RenderBuffer> indexBuffer;
+        uint64_t indexBufferSize = 0;
+        RenderBottomLevelASBuildInfo blasBuildInfo;
+        std::unique_ptr<RenderBuffer> blasBuffer;
+        uint64_t blasBufferSize = 0;
+        std::unique_ptr<RenderAccelerationStructure> blas;
+        uint64_t blasSize = 0;
+        std::unique_ptr<RenderBuffer> blasScratchBuffer;
+        uint64_t blasScratchBufferSize = 0;
+        RenderTopLevelASBuildInfo tlasBuildInfo;
+        std::unique_ptr<RenderBuffer> tlasBuffer;
+        uint64_t tlasBufferSize = 0;
+        std::unique_ptr<RenderAccelerationStructure> tlas;
+        uint64_t tlasSize = 0;
+        std::unique_ptr<RenderBuffer> tlasScratchBuffer;
+        uint64_t tlasScratchBufferSize = 0;
+        std::unique_ptr<RenderBuffer> instancesBuffer;
+        uint64_t instancesBufferSize = 0;
+        std::unique_ptr<RenderBuffer> paramsBuffer;
+        std::unique_ptr<RenderBuffer> statsBuffer;
+        bool statsReset = true;
+
+        // Screen space resources.
+        uint32_t textureWidth = 0;
+        uint32_t textureHeight = 0;
+        std::unique_ptr<RenderTexture> depthTexture;
+        std::unique_ptr<RenderTexture> visibilityTexture;
+        std::unique_ptr<RenderTexture> visibilityTempTexture;
+        std::unique_ptr<RenderTexture> visibilityFilteredTexture;
+        std::unique_ptr<RenderTexture> normalDepthTexture;
+
+        void createPipelines();
+        void updateTextures(uint32_t width, uint32_t height);
+        const CompositePipelines &getCompositePipelines(RenderFormat colorFormat, RenderFormat depthFormat, const RenderMultisampling &multisampling);
+    };
+};
