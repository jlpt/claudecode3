+    // Descriptor sets.
+
+    struct HybridWorldDescriptorSet : RenderDescriptorSetBase {
+        uint32_t srcPos;
+        uint32_t srcVel;
+        uint32_t srcIndices;
+        uint32_t worldMats;
+        uint32_t dstPos;
+
+        HybridWorldDescriptorSet(RenderDevice *device = nullptr) {
+            builder.begin();
+            srcPos = builder.addFormattedBuffer(1);
+            srcVel = builder.addFormattedBuffer(2);
+            srcIndices = builder.addFormattedBuffer(3);
+            worldMats = builder.addStructuredBuffer(4);
+            dstPos = builder.addReadWriteStructuredBuffer(5);
+            builder.end();
+
+            if (device != nullptr) {
+                create(device);
+            }
+        }
+    };
+
+    struct HybridDepthCopyDescriptorSet : RenderDescriptorSetBase {
+        uint32_t gInputDepth;
+        uint32_t gOutputDepth;
+
+        HybridDepthCopyDescriptorSet(RenderDevice *device = nullptr) {
