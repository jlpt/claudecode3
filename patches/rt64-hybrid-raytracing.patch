+    void FramebufferRenderer::setHybridRaytracingStatus(const std::string &kind, const std::string &details) {
+        const std::scoped_lock<std::mutex> statusLock(hybridStatusMutex);
+        hybridStatus = details.empty() ? kind : (kind + ": " + details);
