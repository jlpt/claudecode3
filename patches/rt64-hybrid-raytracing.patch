+    void Application::checkHybridRtConfigUpdates() {
+        // Reload the hybrid ray tracing configuration whenever its file is modified, so it can be tuned while the game runs.
+        const std::chrono::steady_clock::time_point now = std::chrono::steady_clock::now();
+        if ((now - hybridRtConfigCheckTime) < std::chrono::seconds(1)) {
+            return;
+        }
+
+        hybridRtConfigCheckTime = now;
+
+        const std::filesystem::path configPath = HybridRaytracingConfiguration::defaultPath();
+        std::error_code ec;
+        const std::filesystem::file_time_type writeTime = std::filesystem::last_write_time(configPath, ec);
+        if (ec || (writeTime == hybridRtConfigWriteTime)) {
+            return;
+        }
+
+        hybridRtConfigWriteTime = writeTime;
+
+        // Keep the current configuration if the file can't be parsed, as it might still be in the middle of being written.
+        HybridRaytracingConfiguration newConfig;
+        if (!newConfig.load(configPath)) {
+            return;
+        }
+
+        applyHybridRtEnvironment(newConfig);
+        hybridRtConfig = newConfig;
+        updateHybridRtConfig();
+        fprintf(stdout, "RT64: Reloaded hybrid ray tracing configuration from %s.\n", configPath.string().c_str());
+        fflush(stdout);
+    }
+
+    bool Application::isHybridRtSupported() const {
+        return (workloadQueue != nullptr) && (workloadQueue->framebufferRenderer != nullptr) && workloadQueue->framebufferRenderer->isHybridRaytracingSupported();
+    }
+
     void Application::setFullScreen(bool fullscreen) {
         appWindow->setFullScreen(fullscreen);
     }
